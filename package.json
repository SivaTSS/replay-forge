{
  "name": "replayforge-workspace",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "build": "pnpm --workspace-concurrency=1 --recursive build",
    "dev:control": "pnpm --filter @replayforge/control-plane dev",
