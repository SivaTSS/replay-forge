REPLAYFORGE_ARTIFACT_DIRECTORY=capabilities
REPLAYFORGE_EVIDENCE_DIRECTORY=evidence/runtime
REPLAYFORGE_DEMO_BASE_URL=http://127.0.0.1:3001
REPLAYFORGE_BROWSER_HEADLESS=true
REPLAYFORGE_BROWSER_VIEWPORT_WIDTH=1280
REPLAYFORGE_BROWSER_VIEWPORT_HEIGHT=800
REPLAYFORGE_LANGFUSE_BASE_URL=http://127.0.0.1:3100
REPLAYFORGE_MODEL_POLICY_FILE=config/model-policy.yaml
# Enable only for explicitly synthetic pixels; edge signatures are not PII redaction.
REPLAYFORGE_ALLOW_SYNTHETIC_ASSET_CAPTURE=false
